{
  "id": "openclaw-discord",
  "name": "Discord Push Channel",
  "version": "1.0.0",
  "description": "Stateless Discord incoming webhook push notification adapter",
  "channels": ["discord"],
  "entryPoint": "index.js",
  "configSchema": {
    "type": "object",
    "properties": {
      "webhookUrl": {
        "type": "string"
      }
    },
    "required": [
      "webhookUrl"
    ]
  },
  "channelConfigs": {
    "discord": {
      "label": "Discord",
      "description": "Discord incoming webhook account",
      "schema": {
        "type": "object",
        "properties": { "webhookUrl": { "type": "string", "format": "uri" } },
        "required": ["webhookUrl"]
      },
      "uiHints": { "webhookUrl": { "label": "Webhook URL", "sensitive": true } }
    }
  }
}
