{
  "name": "me.ibert.oat-desktop",
  "version": "2026.9.19",
  "private": true,
  "description": "Open Agent Team desktop control center",
  "author": "Herbert He <Herbert.He0229@gmail.com>",
  "packageManager": "pnpm@9.15.9",
  "main": "./out/main/index.js",
  "type": "module",
  "scripts": {
    "predev": "node scripts/ensure-electron.mjs",
    "dev": "node scripts/dev-with-test-team.mjs",
    "build": "electron-vite build",
    "preview": "electron-vite preview",
    "package": "electron-vite build && electron-builder",
    "package:ci": "electron-vite build && electron-builder --publish never",
    "lint": "tsc --noEmit -p tsconfig.node.json && tsc --noEmit -p tsconfig.web.json"
  },
  "devDependencies": {
    "@iconify-json/lucide": "^1.2.124",
    "@svgr/core": "^8.1.0",
    "@svgr/plugin-jsx": "^8.1.0",
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^26.2.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@vitejs/plugin-react": "^6.1.0",
    "electron": "^44.4.1",
    "electron-builder": "^26.15.3",
    "electron-vite": "^5.0.0",
    "less": "^4.9.0",
    "tailwindcss": "^4.3.3",
    "typescript": "~7.0.2",
    "unplugin-icons": "^24.0.0",
    "vite": "^8.2.2"
  },
  "build": {
    "appId": "me.ibert.oat-desktop",
    "productName": "OAT",
    "directories": {
      "output": "release",
      "buildResources": "../logo"
    },
    "files": [
      "out/**/*",
      "package.json"
    ],
    "asarUnpack": [
      "node_modules/@zvec/**/*.node",
      "node_modules/@zvec/**/jieba_dict/**/*"
    ],
    "extraResources": [
      {
        "from": "../src/plugins/bundled",
        "to": "plugins/bundled"
      },
      {
        "from": "../logo/logo-512.png",
        "to": "logo.png"
      }
    ],
    "mac": {
      "icon": "logo.icns",
      "identity": "-",
      "hardenedRuntime": false,
      "target": [
        {
          "target": "dmg",
          "arch": [
            "arm64"
          ]
        }
      ]
    },
    "win": {
      "icon": "logo.ico",
      "signExecutable": false,
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "linux": {
      "icon": "logo-512.png",
      "target": [
        "AppImage"
      ]
    }
  },
  "dependencies": {
    "@ai-sdk/react": "^4.0.76",
    "@earendil-works/pi-coding-agent": "^0.85.1",
    "@zvec/zvec": "0.7.1",
    "ai": "^7.0.73",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
    "typebox": "^1.3.16",
    "zod": "^4.4.3"
  },
  "optionalDependencies": {
    "@zvec/bindings-darwin-arm64": "0.7.1",
    "@zvec/bindings-linux-arm64": "0.7.1",
    "@zvec/bindings-linux-arm64-musl": "0.7.1",
    "@zvec/bindings-linux-x64": "0.7.1",
    "@zvec/bindings-linux-x64-musl": "0.7.1",
    "@zvec/bindings-win32-x64": "0.7.1"
  }
}
