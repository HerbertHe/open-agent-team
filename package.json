{
  "name": "open-agent-team",
  "description": "Declarative multi-agent orchestration powered by pi-coding-agent: Admin → Leader → Worker hierarchy, team.json config, isolated workspaces (git worktree), and the oat CLI.",
  "version": "2026.9.1",
  "private": false,
  "packageManager": "pnpm@9.15.9",
  "type": "module",
  "engines": {
    "node": ">=22 <25"
  },
  "files": [
    "dist",
    "docs",
    "schema",
    "team.example.json",
    "README.md",
    "LICENSE"
  ],
  "bin": {
    "oat": "dist/index.js"
  },
  "scripts": {
    "build": "tsup",
    "start": "node dist/index.js",
    "dev": "tsx watch src/index.ts",
    "test": "tsx watch src/index.ts start --config __test__/niu-ma/team.json",
    "test:memory": "node --import tsx --test src/memory/memory-service.test.ts",
    "test:release-version": "node --test scripts/set-release-version.test.mjs",
    "version:date": "node scripts/set-release-version.mjs",
    "dev:www": "pnpm --filter www run dev",
    "build:www": "pnpm --filter www run build",
    "dev:desktop": "pnpm --filter ./desktop run dev",
    "build:desktop": "pnpm --filter ./desktop run build"
  },
  "license": "MIT",
  "author": {
    "name": "Herbert He",
    "email": "Herbert.He0229@gmail.com"
  },
  "homepage": "https://github.com/herberthe/open-agent-team",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/herberthe/open-agent-team.git"
  },
  "keywords": [
    "agent",
    "agent-orchestration",
    "agent-team",
    "ai",
    "ai-agent",
    "cli",
    "coding-agent",
    "declarative",
    "git-worktree",
    "llm",
    "multi-agent",
    "oat",
    "pi-coding-agent",
    "orchestration",
    "orchestrator",
    "workspace",
    "open-agent-team"
  ],
  "dependencies": {
    "@earendil-works/pi-coding-agent": "^0.84.2",
    "better-sqlite3": "^13.0.3",
    "chalk": "^6.0.0",
    "commander": "^15.0.0",
    "express": "^5.2.1",
    "js-yaml": "^5.3.0",
    "simple-git": "^3.36.0",
    "typebox": "^1.3.16",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^9.6.0",
    "@types/express": "^5.0.6",
    "@types/js-yaml": "^4.0.9",
    "@types/node": "^26.2.0",
    "tsup": "^8.5.1",
    "tsx": "^4.23.12",
    "typescript": "^7.0.2"
  }
}
