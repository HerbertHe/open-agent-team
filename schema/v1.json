{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/HerbertHe/open-agent-team/main/schema/v1.json",
  "title": "Open Agent Team Config",
  "type": "object",
  "required": ["project", "models", "admin", "teams"],
  "additionalProperties": false,
  "$defs": {
    "skillEntry": {
      "type": "object",
      "required": ["source"],
      "additionalProperties": false,
      "properties": {
        "source": {
          "type": "string",
          "minLength": 1,
          "description": "Skill source for npx skills add (GitHub shorthand, URL, or local path)"
        },
        "names": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "description": "Specific skill names to install; omit or use ['*'] for all skills"
        }
      }
    }
  },
  "properties": {
    "$schema": {
      "type": "string",
      "description": "JSON Schema reference for editor validation and auto-completion"
    },
    "model": {
      "type": "string",
      "minLength": 1
    },
    "providers": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "required": ["compatible_type"],
        "additionalProperties": false,
        "properties": {
          "compatible_type": {
            "type": "string",
            "enum": ["openai", "anthropic"],
            "description": "API compatibility type"
          },
          "base_url": {
            "type": "string",
            "minLength": 1,
            "description": "API base URL"
          },
          "api_key": {
            "type": "string",
            "minLength": 1,
            "description": "API key"
          }
        }
      }
    },
    "memory": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "enabled": { "type": "boolean", "default": true },
        "roles": {
          "type": "array",
          "items": { "type": "string", "enum": ["admin", "leader", "worker"] },
          "default": ["admin", "leader", "worker"]
        },
        "access": {
          "type": "object",
          "additionalProperties": false,
          "description": "M13 explicit long-term memory grants. Leaders remain team-scoped unless their team is listed.",
          "properties": {
            "leaderProjectScopeTeams": {
              "type": "array",
              "maxItems": 200,
              "items": { "type": "string", "minLength": 1 },
              "default": []
            }
          }
        },
        "database": { "type": "string", "minLength": 1 },
        "embeddingRef": {
          "oneOf": [
            { "type": "string", "minLength": 1 },
            { "type": "null" }
          ],
          "description": "Reference to a global embeddingProfiles entry; null explicitly disables inherited embedding."
        },
        "retrieval": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "backend": { "type": "string", "enum": ["lexical", "zvec_fts", "zvec_hybrid"], "default": "lexical" },
            "fallback": { "type": "string", "enum": ["lexical"], "default": "lexical" },
            "shadow": { "type": "boolean", "default": false },
            "candidateLimit": { "type": "integer", "minimum": 1, "maximum": 500, "default": 30 },
            "maxResults": { "type": "integer", "minimum": 1, "maximum": 50, "default": 8 },
            "maxPromptTokens": { "type": "integer", "minimum": 128, "maximum": 32768, "default": 1800 },
            "timeoutMs": { "type": "integer", "minimum": 100, "maximum": 120000, "default": 3000 },
            "circuitBreakerFailureThreshold": { "type": "integer", "minimum": 1, "maximum": 20, "default": 3 },
            "circuitBreakerCooldownSeconds": { "type": "integer", "minimum": 1, "maximum": 3600, "default": 60 }
          }
        },
        "zvec": {
          "type": "object",
          "additionalProperties": false,
          "description": "Storage and index settings only. Embedding identity is resolved exclusively from embeddingRef.",
          "properties": {
            "path": { "type": "string", "minLength": 1, "default": "memory/zvec" },
            "index": { "type": "string", "enum": ["flat", "hnsw"], "default": "flat" },
            "metric": { "type": "string", "enum": ["cosine"], "default": "cosine" },
            "readOnlyFallback": { "type": "boolean", "default": true },
            "batchSize": { "type": "integer", "minimum": 1, "maximum": 2048, "default": 64 },
            "maxAttempts": { "type": "integer", "minimum": 1, "maximum": 32, "default": 8 },
            "optimizePendingThreshold": { "type": "integer", "minimum": 1, "default": 100000 }
          }
        },
        "extraction": {
          "type": "object",
          "additionalProperties": false,
          "description": "Optional M11 structured fact extraction. Without an enabled, valid model, legacy deterministic consolidation remains active.",
          "properties": {
            "enabled": { "type": "boolean", "default": false },
            "model": { "type": "string", "minLength": 1, "description": "Model alias or provider/model identifier used only for memory extraction." },
            "version": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$", "default": "m11-v1" },
            "timeoutMs": { "type": "integer", "minimum": 100, "maximum": 120000, "default": 15000 },
            "maxInputChars": { "type": "integer", "minimum": 256, "maximum": 32000, "default": 4000 },
            "maxOutputTokens": { "type": "integer", "minimum": 64, "maximum": 4096, "default": 800 },
            "maxFactsPerEvent": { "type": "integer", "minimum": 1, "maximum": 20, "default": 5 },
            "maxAttempts": { "type": "integer", "minimum": 1, "maximum": 8, "default": 3 }
          }
        },
        "l1": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "maxItems": { "type": "integer", "minimum": 5, "maximum": 100, "default": 24 },
            "completedTaskTtlHours": { "type": "integer", "minimum": 1, "maximum": 720, "default": 48 }
          }
        },
        "l2": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "maxResults": { "type": "integer", "minimum": 1, "maximum": 20, "default": 5 },
            "retentionDays": { "type": "integer", "minimum": 1, "maximum": 3650, "default": 180 }
          }
        },
        "l3": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "maxPromptItems": { "type": "integer", "minimum": 1, "maximum": 20, "default": 5 },
            "minEvidence": { "type": "integer", "minimum": 2, "maximum": 20, "default": 2 }
          }
        },
        "dream": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "enabled": { "type": "boolean", "default": true },
            "idleAfterSeconds": { "type": "integer", "minimum": 30, "maximum": 86400, "default": 300 },
            "pollSeconds": { "type": "integer", "minimum": 5, "maximum": 3600, "default": 30 },
            "maxEventsPerRun": { "type": "integer", "minimum": 10, "maximum": 5000, "default": 250 },
            "cancelOnNewTask": { "type": "boolean", "default": true }
          }
        }
      }
    },
    "knowledge": {
      "type": "object",
      "additionalProperties": false,
      "description": "File-backed team and project knowledge. Embedding, retrieval and Zvec settings are inherited from memory.",
      "properties": {
        "enabled": { "type": "boolean", "default": true },
        "roots": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "project": { "type": "string", "minLength": 1, "default": "knowledge/project" },
            "teams": { "type": "string", "minLength": 1, "default": "knowledge/teams" },
            "uploads": { "type": "string", "minLength": 1, "default": "knowledge/uploads" }
          }
        },
        "watcher": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "enabled": { "type": "boolean", "default": true },
            "debounceMs": { "type": "integer", "minimum": 100, "maximum": 60000, "default": 1000 }
          }
        },
        "ingestion": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "maxFileSizeMb": { "type": "integer", "minimum": 1, "maximum": 2048, "default": 50 },
            "chunkTokens": { "type": "integer", "minimum": 128, "maximum": 8192, "default": 1000 },
            "chunkOverlapTokens": { "type": "integer", "minimum": 0, "maximum": 2048, "default": 120 }
          }
        }
      }
    },
    "project": {
      "type": "object",
      "required": ["name", "repo", "base_branch"],
      "additionalProperties": false,
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1
        },
        "repo": {
          "type": "string",
          "minLength": 1
        },
        "base_branch": {
          "type": "string",
          "enum": ["main", "master"],
          "default": "main",
          "description": "Primary integration branch for leader merges; only main or master."
        }
      }
    },
    "runtime": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "mode": {
          "type": "string",
          "enum": ["local_process", "docker"],
          "default": "local_process",
          "description": "Runtime isolation. Migration from local_process to docker is one-way."
        },
        "docker": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "image": { "type": "string", "minLength": 1 },
            "network": { "type": "string", "enum": ["none", "bridge", "host"], "default": "bridge" },
            "extra_args": {
              "type": "array",
              "items": {
                "oneOf": [
                  { "enum": ["--read-only", "--cap-drop=ALL", "--security-opt=no-new-privileges"] },
                  { "type": "string", "pattern": "^--cpus=[0-9]+(\\.[0-9]+)?$" },
                  { "type": "string", "pattern": "^--memory(-swap)?=-?[0-9]+[kKmMgG]?$" },
                  { "type": "string", "pattern": "^--pids-limit=[0-9]+$" },
                  { "type": "string", "pattern": "^--ulimit=[a-z_]+=[0-9]+(:[0-9]+)?$" },
                  { "type": "string", "pattern": "^--tmpfs=/tmp(:[A-Za-z0-9,=_-]+)?$" }
                ]
              },
              "default": []
            }
          },
          "required": ["image"]
        },
        "persistence": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "state_dir": {
              "type": "string",
              "minLength": 1,
              "default": ".oat/state"
            }
          }
        }
      }
    },
    "workspace": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "provider": {
          "type": "string",
          "enum": ["worktree", "shared_clone", "full_clone"],
          "default": "worktree"
        },
        "root_dir": {
          "type": "string",
          "minLength": 1,
          "default": "workspaces"
        },
        "git": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "remote": {
              "type": "string",
              "minLength": 1
            },
            "remote_url": {
              "type": "string",
              "minLength": 1
            },
            "user_name": {
              "type": "string",
              "minLength": 1
            },
            "user_email": {
              "type": "string",
              "minLength": 3
            },
            "push_enabled": {
              "type": "boolean",
              "default": false
            },
            "lfs": {
              "type": "string",
              "enum": ["pull", "skip", "allow_pull_deny_change"],
              "default": "pull"
            }
          }
        },
        "sparse_checkout": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "enabled": {
              "type": "boolean",
              "default": true
            }
          }
        }
      }
    },
    "models": {
      "type": "object",
      "additionalProperties": {
        "type": "string",
        "minLength": 1
      }
    },
    "admin": {
      "type": "object",
      "required": ["name", "description", "prompt"],
      "additionalProperties": false,
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1
        },
        "description": {
          "type": "string",
          "minLength": 1
        },
        "model": {
          "type": "string",
          "minLength": 1
        },
        "prompt": {
          "type": "string",
          "minLength": 1
        },
        "skills": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/skillEntry"
          },
          "default": []
        }
      }
    },
    "teams": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["name", "branch_prefix", "leader", "worker"],
        "additionalProperties": false,
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1
          },
          "branch_prefix": {
            "type": "string",
            "minLength": 1
          },
          "leader": {
            "type": "object",
            "required": ["name", "description", "prompt"],
            "additionalProperties": false,
            "properties": {
              "name": {
                "type": "string",
                "minLength": 1
              },
              "description": {
                "type": "string",
                "minLength": 1
              },
              "model": {
                "type": "string",
                "minLength": 1
              },
              "prompt": {
                "type": "string",
                "minLength": 1
              },
              "skills": {
                "type": "array",
                "items": {
                  "$ref": "#/$defs/skillEntry"
                },
                "default": []
              },
              "repos": {
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1
                },
                "default": []
              }
            }
          },
          "worker": {
            "type": "object",
            "required": ["total", "prompt"],
            "additionalProperties": false,
            "properties": {
              "total": {
                "type": "integer",
                "minimum": 1
              },
              "model": {
                "type": "string",
                "minLength": 1
              },
              "prompt": {
                "type": "string",
                "minLength": 1
              },
              "extra_skills": {
                "type": "array",
                "items": {
                  "$ref": "#/$defs/skillEntry"
                },
                "default": []
              },
              "skill_sync": {
                "type": "string",
                "enum": ["inherit_and_inject_on_spawn", "manual"],
                "default": "inherit_and_inject_on_spawn"
              }
            }
          }
        }
      }
    }
  }
}
